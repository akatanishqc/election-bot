# ─────────────────────────────────────────
# ECI Election Bot — .gitignore
# ─────────────────────────────────────────

# ── Environment files (NEVER commit these) ──
.env
.env.local
.env.development
.env.production
.env.*.local
backend/.env
frontend/.env.local

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ── Node / Next.js ──
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── ECI Documents (may be large PDFs) ──
backend/eci_docs/
ingestion/failed_chunks.jsonl

# ── OS files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# ── Logs ──
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ── Render / Vercel ──
.vercel/
.render/

# ── Misc ──
*.bak
*.tmp
*.temp
.cache/